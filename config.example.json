    // CLIENT PATHS. Both are optional: leave them empty and the server runs, the admin panel just
    // shows no pictures or 3D models. Use forward slashes or doubled backslashes on Windows.

    // Your Red Moon Rising client install, the folder that holds eve.exe, e.g. "D:/Games/EVE".
    // The server only reads from it. Used for:
    //   icons/                       item and type icons in the admin panel
    //   cache/Pictures/Portraits/    character and agent portraits (/portrait/<id> falls back to it)
    //   cache/Pictures/Gids/         rendered type snapshots where a type has no 2D icon
    //   res/, extracted_res*/, *.stuff   model pipeline: .blue/.tri/.red/.dds source files the
    //                                admin panel builds 3D previews from, plus nebula cubemaps,
    //                                corporation and alliance logo atlases
    //   res/introMovie.txt           intro movie subtitles sent to the client
    // The tools in cmd/audiorestore and cmd/clientpatch also default to this path when run
    // without -client; they write into it (station sounds and client patches).
    "clientPath": "",

    // Folders of already converted .glb models (one per ship, station or structure type).
    // The admin panel indexes them for its 3D viewer; folders that do not exist are skipped.
    // A sibling folder named "nebulas" next to the first entry supplies skybox models.
    // Not needed if clientPath is set and the model pipeline can build from the client files.
    // Example: ["D:/GuriMoon/models", "D:/more-models"]
    "modelsDirs": [],
    "pprof": true,
    "sessionDays": 30
  },
