# Build outputs
*.exe
/gurimoon
build/

# Your own settings (copy config.example.json to config.json)
config.json

# Modules you drop into modules\ are their own repositories.
/modules/*/

# Logs
*.log

# Per-install state created at run time: admin panel login key, uploaded
# images, portraits. Keep data/strings.txt, the server needs it.
data/*
!data/strings.txt
gurimoon.exe~
